{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Problem trajectory public input contracts",
  "description": "Validation is local. Runtime additionally limits UTF-8 bytes, checks sanitized text, integer literals, overlapping snapshots and saved state.",
  "oneOf": [
    {
      "$ref": "#/$defs/report"
    },
    {
      "$ref": "#/$defs/batch"
    },
    {
      "$ref": "#/$defs/selection"
    },
    {
      "$ref": "#/$defs/settings"
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$"
    },
    "descriptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "sanitizedScenario",
        "availableCommands",
        "missingCapability",
        "wrapperAlgorithm",
        "expectedOutcome",
        "cliVersion",
        "skillVersion"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "sanitizedScenario": {
          "$ref": "#/$defs/text"
        },
        "availableCommands": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^(?:[a-z][a-z0-9]*(?:[-:][a-z0-9]+)*|--[a-z][a-z0-9-]*)$"
          }
        },
        "missingCapability": {
          "$ref": "#/$defs/text"
        },
        "wrapperAlgorithm": {
          "$ref": "#/$defs/descriptions"
        },
        "expectedOutcome": {
          "$ref": "#/$defs/text"
        },
        "cliVersion": {
          "$ref": "#/$defs/version"
        },
        "skillVersion": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/version"
            }
          ]
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupId",
        "cardIds",
        "owner",
        "title",
        "expected",
        "actual",
        "syntheticReproduction",
        "acceptanceCriteria",
        "confidence",
        "deduplication",
        "decision",
        "issueLinks"
      ],
      "properties": {
        "groupId": {
          "$ref": "#/$defs/identifier"
        },
        "cardIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        },
        "owner": {
          "enum": [
            "cli",
            "skill/docs",
            "environment",
            "unclear"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expected": {
          "$ref": "#/$defs/text"
        },
        "actual": {
          "$ref": "#/$defs/text"
        },
        "syntheticReproduction": {
          "$ref": "#/$defs/descriptions"
        },
        "acceptanceCriteria": {
          "$ref": "#/$defs/descriptions"
        },
        "confidence": {
          "enum": [
            "hypothesis",
            "confirmed",
            "unclear"
          ]
        },
        "deduplication": {
          "enum": [
            "checked",
            "unchecked"
          ]
        },
        "decision": {
          "enum": [
            "candidate",
            "linked-existing",
            "dismissed"
          ]
        },
        "issueLinks": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "pattern": "^https://github\\.com/mesilov/bitrix24-cli(?:-skill)?/issues/[1-9][0-9]*$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "linked-existing"
              }
            }
          },
          "then": {
            "properties": {
              "issueLinks": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "batchId",
        "groups"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "batchId": {
          "$ref": "#/$defs/identifier"
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/group"
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupRefs"
      ],
      "properties": {
        "groupRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "collectProblemTrajectories": {
          "type": "boolean"
        },
        "maxProblemTrajectoryFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    }
  }
}
