# Incoming webhook with tasks, task and im permissions. Keep .env.local/.env untracked.
BITRIX24_WEBHOOK=

# Existing Disk file (kept intact); empty value creates and cleans up an owned file (requires disk scope).
B24CLI_TEST_DISK_FILE_ID=
# Optional denied-role fixture; empty value skips that case.
B24CLI_TEST_RESTRICTED_WEBHOOK=
